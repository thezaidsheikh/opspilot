{
  "include": ["apps/api/src", "scripts", "tests"],
  "exclude": [
    "**/__pycache__",
    "**/.venv",
    "**/.pytest_cache",
    "**/build",
    "**/dist",
  ],
  "typeCheckingMode": "basic",
  "pythonVersion": "3.12",
  "executionEnvironments": [
    {
      "root": "apps/api",
      "extraPaths": ["apps/api/src"],
    },
    {
      "root": ".",
      "extraPaths": ["apps/api/src"],
    },
  ],
}
